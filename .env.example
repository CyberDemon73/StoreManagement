# --- Database (Neon) ---
DATABASE_URL=postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/avenue?sslmode=require   # pooled, runtime
DATABASE_URL_UNPOOLED=postgres://user:pass@ep-xxx.region.aws.neon.tech/avenue?sslmode=require   # direct, migrations

# --- Redis (Upstash) --- rate limits, lockouts, analytics memo, idempotency
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# --- Storage (Vercel Blob) --- product images (injected automatically when the store is linked)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# --- Email (Resend) --- password reset + invites
RESEND_API_KEY=re_xxx
EMAIL_FROM="Avenue Stock <no-reply@yourdomain.com>"

# --- App ---
APP_URL=http://localhost:3000            # public origin; used for CSRF origin check and email links
SESSION_SECRET=change-me-32-bytes-base64 # openssl rand -base64 32
SETUP_TOKEN=change-me                     # required once by POST /setup
CRON_SECRET=change-me                     # Vercel Cron bearer token
NODE_ENV=development
LOG_LEVEL=info

# --- Optional ---
SENTRY_DSN=
