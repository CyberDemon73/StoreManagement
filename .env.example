# --- Database (Neon) ---
DATABASE_URL=                 # Neon POOLED connection string (host contains "-pooler"); required
DATABASE_URL_UNPOOLED=        # Neon DIRECT connection string; used by pnpm db:migrate

# --- Redis (Upstash) --- rate limits, lockouts, analytics memo, idempotency
# leave empty locally → in-memory limiter (per instance); required in production
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Storage (Vercel Blob) --- product images (injected automatically when the store is linked)
# required for product image uploads (Sprint 1); injected by Vercel Blob
BLOB_READ_WRITE_TOKEN=

# --- Email (Resend) --- password reset + invites
# leave empty locally → emails are logged instead of sent; required in production
RESEND_API_KEY=
EMAIL_FROM="Avenue Stock <no-reply@yourdomain.com>"

# --- App ---
APP_URL=http://localhost:3000            # public origin; used for CSRF origin check and email links
SESSION_SECRET=                          # reserved for signed non-session cookies (not used yet)
SETUP_TOKEN=change-me-to-at-least-16-chars # openssl rand -hex 16
# leave empty locally → cron routes disabled; Vercel Cron bearer token in production
CRON_SECRET=
LOG_LEVEL=info

# --- Optional ---
SENTRY_DSN=

# Frontend: 1 = every screen uses the in-memory mock store (demo/offline design work). Leave unset in production.
NEXT_PUBLIC_USE_MOCK=
